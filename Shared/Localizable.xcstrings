    "%@ set a %@ countdown, including %@ still owed from before it. It ran out %@, so nothing is outstanding.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: odpočet %2$@, včetně %3$@ z dřívějška. Skončil %4$@, takže nic nezbývá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat einen Countdown von %@ gesetzt, darin enthalten %@ aus der Zeit davor. Er ist %@ abgelaufen, daher steht nichts mehr aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ set a %@ countdown, including %@ still owed from before it. It ran out %@, so nothing is outstanding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ marcó una cuenta atrás de %2$@, con %3$@ pendientes de antes. Terminó %4$@, así que no queda nada pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a lancé un compte à rebours de %@, dont %@ déjà à récupérer avant. Il s’est terminé %@, donc rien n’est en attente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha avviato un conto alla rovescia di %@, inclusi %@ ancora in sospeso da prima. È terminato %@, quindi non c'è nulla in sospeso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ตั้งการนับถอยหลัง %@ ซึ่งรวม %@ ที่ค้างมาจากก่อนหน้า การนับหมดลงเมื่อ %@ จึงไม่เหลือเวลาค้างอยู่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 带来了 %2$@ 的倒计时，其中包含此前仍需的 %3$@。该倒计时已于 %4$@ 结束，没有未完成的恢复时间。"
          }
        }
      }
    },
