    "You pinned %@ to this intensity, so the model's own figure is not used here.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tuto intenzitu máš nastaveno %@, proto se zde nepoužije hodnota modelu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@ auf diese Intensität festgelegt, daher wird der Wert des Modells hier nicht verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pinned %@ to this intensity, so the model's own figure is not used here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijaste %@ en esta intensidad, así que aquí no se usa la cifra propia del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as fixé %@ sur cette intensité, la valeur propre au modèle n'est donc pas utilisée ici."
          }
        },
        "it": {
