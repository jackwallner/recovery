    "Someone training six days a week is adapted to a shorter turnaround than someone training two.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Člověk, který trénuje šest dní v týdnu, je zvyklý na kratší dobu mezi tréninky než ten, kdo trénuje dva dny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer sechs Tage pro Woche trainiert, ist an kürzere Abstände zwischen Einheiten gewöhnt als jemand, der zweimal trainiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone training six days a week is adapted to a shorter turnaround than someone training two."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien entrena seis días a la semana está adaptado a un plazo de recuperación más corto que quien entrena dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un qui s’entraîne six jours par semaine est habitué à un délai plus court que quelqu’un qui s’entraîne deux jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi si allena sei giorni a settimana si adatta a tempi di recupero più brevi rispetto a chi si allena due."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ที่ฝึกหกวันต่อสัปดาห์จะปรับตัวกับช่วงพักที่สั้นกว่าผู้ที่ฝึกสองวัน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周训练六天的人，适应的恢复周期比每周训练两天的人更短。"
          }
        }
      }
    },
