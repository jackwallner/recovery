    "You marked this hard, so that is what the countdown was built from.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpočet vychází z tvého označení „náročný“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dies als intensiv markiert, daher basiert der Countdown darauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You marked this hard, so that is what the countdown was built from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo marcaste como intenso, así que la cuenta atrás se calculó a partir de eso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as indiqué que c'était intense, le compte à rebours est donc calculé sur cette base."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo hai indicato come intenso, quindi il conto alla rovescia è stato calcolato su questa base."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณระบุว่าหนัก จึงใช้ระดับนี้คำนวณการนับถอยหลัง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将这次标记为高强度，倒计时就是据此生成的。"
          }
        }
      }
    },
    "You marked this light, so that is what the countdown was built from.": {
