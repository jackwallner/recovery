    "Every figure here is going into your estimate. Anything Recharge asked for and is not using does not appear.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý údaj zde vstupuje do tvého odhadu. Co Recharge vyžádal, ale nepoužívá, se nezobrazuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Wert hier fließt in deine Schätzung ein. Was Recharge angefragt hat und nicht nutzt, erscheint nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every figure here is going into your estimate. Anything Recharge asked for and is not using does not appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las cifras de aquí se incluyen en tu estimación. Lo que Recharge solicitó y no usa no aparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les valeurs affichées ici entrent dans ton estimation. Ce que Recharge a demandé sans l'utiliser n'apparaît pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni dato qui indicato entra nella tua stima. Ciò che Recharge ha richiesto ma non usa non compare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลขทุกตัวที่แสดงที่นี่ถูกนำไปใช้ในค่าประมาณของคุณ ข้อมูลที่ Recharge ขอแต่ไม่ได้ใช้จะไม่แสดง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的每项数据都会纳入你的估算。Recharge 请求了但未使用的数据不会显示。"
          }
        }
      }
    },
    "Every session is scored against your own %lld-day baseline, then adjusted by what the last %lld days show about how quickly you come back. It is a cardiovascular training estimate, not medical advice.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý trénink se hodnotí podle tvé vlastní %1$llddenní základní úrovně a upraví se podle údajů za %#@n2@ o tom, jak rychle regeneruješ. Jde o odhad kardiovaskulární tréninkové zátěže, ne o lékařskou radu."
          },
          "substitutions": {
            "n2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "poslední %arg dny"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "poslední %arg dne"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "poslední %arg den"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "posledních %arg dní"
                    }
                  }
                }
              }
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Einheit wird an deinem eigenen %1$lld-Tage-Basiswert gemessen und dann danach angepasst, wie schnell du dich laut den Daten aus %#@n2@ erholst. Das ist eine Schätzung zum Herz-Kreislauf-Training, kein medizinischer Rat."
          },
          "substitutions": {
            "n2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "dem letzten %arg Tag"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "den letzten %arg Tagen"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every session is scored against your own %1$lld-day baseline, then adjusted by what the last %#@n2@ show about how quickly you come back. It is a cardiovascular training estimate, not medical advice."
          },
          "substitutions": {
            "n2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg day"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg days"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sesión se valora con tu propia línea base de %1$lld días y se ajusta según lo que indica tu historial durante %#@n2@ sobre lo rápido que te recuperas. Es una estimación de entrenamiento cardiovascular, no un consejo médico."
          },
          "substitutions": {
            "n2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "los últimos %arg días"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "el último %arg día"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "los últimos %arg días"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque séance est comparée à ta propre base de %1$lld jours, puis ajustée selon ce que montrent %#@n2@ sur la rapidité de ton retour en forme. C’est une estimation d’entraînement cardiovasculaire, pas un avis médical."
          },
          "substitutions": {
            "n2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "les %arg derniers jours"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "le %arg dernier jour"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "les %arg derniers jours"
                    }
                  }
                }
              }
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sessione viene valutata rispetto alla tua base personale di %1$lld giorni, poi corretta in base a ciò che mostrano i dati %#@n2@ sulla rapidità con cui ti riprendi. È una stima dell'allenamento cardiovascolare, non un consiglio medico."
          },
          "substitutions": {
