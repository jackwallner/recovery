            "state": "translated",
            "value": "ลบข้อมูลสุขภาพในเครื่องไหม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除本地健康数据？"
          }
        }
      }
    },
    "Deletes Recharge's local Health cache and derived estimates. Apple Health records and purchases are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže místní mezipaměť dat z Health a odvozené odhady aplikace Recharge. Záznamy v Apple Health a nákupy zůstanou beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den lokalen Health-Cache und die abgeleiteten Schätzungen von Recharge. Einträge in Apple Health und Käufe bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes Recharge's local Health cache and derived estimates. Apple Health records and purchases are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la caché local de Health de Recharge y las estimaciones derivadas. Los registros de Apple Health y las compras no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le cache Health local de Recharge et les estimations qui en découlent. Les données d'Apple Health et les achats ne sont pas affectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la cache locale Health di Recharge e le stime derivate. I dati di Apple Health e gli acquisti non vengono toccati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบแคชข้อมูลสุขภาพในเครื่องของ Recharge และค่าประมาณที่คำนวณได้ ระเบียนใน Apple Health และการซื้อจะไม่ได้รับผลกระทบ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除 Recharge 本地的 Health 缓存及由此得出的估算。Apple Health 记录和购买项目不受影响。"
          }
        }
      }
    },
    "Describe what would make the countdown more useful.": {
