        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันที่ถี่ติดกันจะสะสม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "间隔较近的训练会叠加"
          }
        }
      }
    },
    "Sessions you started inside the window came in below your usual intensity.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tréninky zahájené uvnitř okna měly nižší intenzitu, než je u tebe obvyklé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einheiten, die du innerhalb des Zeitfensters begonnen hast, lagen unter deiner üblichen Intensität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions you started inside the window came in below your usual intensity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones que empezaste dentro de la ventana quedaron por debajo de tu intensidad habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séances commencées pendant la fenêtre étaient en dessous de ton intensité habituelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni iniziate durante la finestra sono state sotto la tua intensità abituale."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันที่คุณเริ่มภายในช่วงนี้มีความหนักต่ำกว่าปกติของคุณ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在恢复窗口内开始的训练，强度低于你的日常水平。"
          }
        }
      }
    },
    "Sets the heart-rate ceiling every session is measured against, and how quickly the window closes.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určuje horní hranici tepové frekvence, podle které se každý trénink měří, a jak rychle se okno zavírá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Herzfrequenz-Obergrenze fest, an der jede Einheit gemessen wird, und wie schnell sich das Zeitfenster schließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the heart-rate ceiling every session is measured against, and how quickly the window closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija el límite de frecuencia cardiaca con el que se mide cada sesión y la rapidez con que se cierra la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le plafond de fréquence cardiaque auquel chaque séance est comparée, ainsi que la vitesse de fermeture de la fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il limite di frequenza cardiaca rispetto al quale è misurata ogni sessione e la rapidità con cui si chiude la finestra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดเพดานอัตราการเต้นของหัวใจที่ใช้เทียบทุกเซสชัน และความเร็วที่ช่วงการฟื้นตัวสิ้นสุดลง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定每次训练所对照的心率上限，以及恢复窗口结束的快慢。"
          }
        }
      }
    },
    "Sets the heart-rate ceiling until your workouts show a higher one.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určuje horní hranici tepové frekvence, dokud tvé tréninky neukážou vyšší."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Herzfrequenz-Obergrenze fest, bis deine Workouts eine höhere zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the heart-rate ceiling until your workouts show a higher one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija el límite de frecuencia cardiaca hasta que tus entrenamientos muestren uno más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le plafond de fréquence cardiaque jusqu’à ce que tes entraînements en montrent un plus élevé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il limite di frequenza cardiaca finché i tuoi allenamenti non ne mostrano uno più alto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดเพดานอัตราการเต้นของหัวใจ จนกว่าการออกกำลังกายของคุณจะแสดงค่าที่สูงกว่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定心率上限，直到你的体能训练显示出更高的数值。"
          }
        }
      }
    },
    "Sets the training level your sessions are compared against.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určuje úroveň tréninku, se kterou se tvé tréninky srovnávají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt das Trainingsniveau fest, mit dem deine Einheiten verglichen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the training level your sessions are compared against."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija el nivel de entrenamiento con el que se comparan tus sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le niveau d’entraînement auquel tes séances sont comparées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il livello di allenamento con cui vengono confrontate le tue sessioni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดระดับการฝึกที่ใช้เปรียบเทียบเซสชันของคุณ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定用来与你的训练进行对比的训练水平。"
          }
        }
      }
    },
