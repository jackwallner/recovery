    },
    "Apple has marked this purchase as pending. It may finish later. Restore purchases or reopen Recharge to check again.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple označil tento nákup jako čekající na vyřízení. Může se dokončit později. Obnov nákupy nebo znovu otevři Recharge a zkontroluj to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat diesen Kauf als ausstehend markiert. Er kann später abgeschlossen werden. Stelle Käufe wieder her oder öffne Recharge erneut, um noch einmal zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple has marked this purchase as pending. It may finish later. Restore purchases or reopen Recharge to check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ha marcado esta compra como pendiente. Puede completarse más tarde. Restaura las compras o vuelve a abrir Recharge para comprobarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a marqué cet achat comme en attente. Il peut aboutir plus tard. Restaure les achats ou rouvre Recharge pour vérifier à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ha contrassegnato questo acquisto come in sospeso. Potrebbe completarsi più tardi. Ripristina gli acquisti o riapri Recharge per ricontrollare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ระบุว่ารายการซื้อนี้อยู่ระหว่างดำเนินการ อาจเสร็จสมบูรณ์ภายหลัง กู้คืนการซื้อหรือเปิด Recharge อีกครั้งเพื่อตรวจสอบ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已将此次购买标记为待处理，可能稍后完成。你可以恢复购买，或重新打开 Recharge 再次查看。"
          }
        }
      }
    },
    "Applies to all four complication families. Add Recharge to a watch face from the Watch app.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pro všechny čtyři skupiny komplikací. Recharge přidáš na ciferník v aplikaci Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für alle vier Complication-Familien. Füge Recharge in der Watch-App einem Zifferblatt hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to all four complication families. Add Recharge to a watch face from the Watch app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a las cuatro familias de complicaciones. Añade Recharge a una esfera desde la app Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique aux quatre familles de complications. Ajoute Recharge à un cadran depuis l'app Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per tutte e quattro le famiglie di complicazioni. Aggiungi Recharge a un quadrante dall'app Watch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับคอมพลิเคชันทั้งสี่แบบ เพิ่ม Recharge ลงในหน้าปัดนาฬิกาได้จากแอป Watch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于全部四种复杂功能样式。请在 Watch App 中将 Recharge 添加到表盘。"
          }
        }
      }
    },
