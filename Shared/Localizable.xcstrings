    "%@ Telling Recharge how it went tunes your own bands.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Když v Recharge zadáš, jak to šlo, upraví se tvá vlastní pásma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Wenn du Recharge sagst, wie es lief, passt die App deine persönlichen Bereiche an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Telling Recharge how it went tunes your own bands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Contarle a Recharge cómo te fue ajusta tus propias franjas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ En indiquant à Recharge comment ça s’est passé, tu affines tes propres plages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Dire a Recharge com'è andata affina le tue fasce personali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ บอก Recharge ว่ารู้สึกอย่างไร เพื่อปรับช่วงความหนักให้เหมาะกับคุณ"
