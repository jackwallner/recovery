    "Recharge is scoring the last %lld days of workouts from Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge hodnotí tréninky z Apple Health za %#@n1@."
          },
          "substitutions": {
            "n1": {
              "argNum": 1,
              "formatSpecifier": "lld",
