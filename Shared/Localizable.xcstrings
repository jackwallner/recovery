    "Active recovery": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivní regenerace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Erholung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active recovery"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperación activa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupération active"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupero attivo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การฟื้นตัวแบบแอ็กทีฟ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主动恢复"
          }
        }
      }
    },
    "Active recovery. Counted toward your training load, and it never starts or extends a countdown.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivní regenerace. Počítá se do tvé tréninkové zátěže a nikdy nespouští ani neprodlužuje odpočet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Erholung. Zählt zu deiner Trainingsbelastung und startet oder verlängert nie einen Countdown."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active recovery. Counted toward your training load, and it never starts or extends a countdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperación activa. Cuenta para tu carga de entrenamiento y nunca inicia ni alarga una cuenta atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupération active. Comptée dans ta charge d’entraînement, elle ne lance et ne prolonge jamais de compte à rebours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupero attivo. Conta nel tuo carico di allenamento e non avvia né allunga mai un conto alla rovescia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การฟื้นตัวแบบแอ็กทีฟ นับรวมในภาระการฝึก แต่จะไม่เริ่มหรือเพิ่มเวลาการนับถอยหลัง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主动恢复。计入你的训练负荷，不会开始或延长倒计时。"
          }
        }
      }
    },
    "Adds another overnight signal to the estimate alongside sleep, HRV, and resting heart rate.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidává do odhadu další noční signál vedle spánku, HRV a klidové tepové frekvence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt der Schätzung neben Schlaf, HRV und Ruhepuls ein weiteres nächtliches Signal hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds another overnight signal to the estimate alongside sleep, HRV, and resting heart rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade otra señal nocturna a la estimación, junto con el sueño, la VFC y la frecuencia cardiaca en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un autre signal nocturne à l’estimation, en plus du sommeil, de la VFC et de la fréquence cardiaque au repos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge alla stima un altro segnale notturno, insieme a sonno, HRV e frequenza cardiaca a riposo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มสัญญาณช่วงกลางคืนอีกหนึ่งอย่างให้ค่าประมาณ ควบคู่กับการนอนหลับ HRV และอัตราการเต้นของหัวใจขณะพัก"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在睡眠、心率变异性和静息心率之外，为估算再增加一项夜间信号。"
          }
        }
      }
    },
