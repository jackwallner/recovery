          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้อ่านข้อมูล Apple Health - เปิด Recharge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
