          }
        }
      }
    },
    "Heart rate was patchy. Your rating counts whenever it reads harder than the sensors did.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznam tepové frekvence byl neúplný. Tvé hodnocení se započítá vždy, když vyjde náročněji než údaje ze senzorů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Herzfrequenz war lückenhaft. Deine Bewertung zählt immer dann, wenn sie intensiver ausfällt als die Messung der Sensoren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart rate was patchy. Your rating counts whenever it reads harder than the sensors did."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frecuencia cardiaca tuvo lagunas. Tu valoración cuenta siempre que indique un esfuerzo mayor que el de los sensores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de fréquence cardiaque étaient incomplètes. Ta note compte dès qu’elle indique un effort plus intense que les capteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La frequenza cardiaca è risultata discontinua. La tua valutazione conta ogni volta che indica uno sforzo maggiore di quello rilevato dai sensori."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลอัตราการเต้นของหัวใจขาดช่วง ระบบจะใช้คะแนนของคุณเมื่อคุณให้คะแนนว่าหนักกว่าที่เซนเซอร์วัดได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
