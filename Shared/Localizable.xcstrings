    "You marked this session hard, so that is what it was scored as.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trénink byl vyhodnocen podle tvého označení „náročný“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diese Einheit als intensiv markiert, daher wurde sie so bewertet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You marked this session hard, so that is what it was scored as."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcaste esta sesión como intensa, así que se valoró como tal."
          }
        },
        "fr": {
