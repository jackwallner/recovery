            "value": "Sensación: Listo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt selon moi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi sentivo pronto"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รู้สึกพร้อม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感觉就绪"
          }
        }
      }
    },
    "Finish a qualifying workout and Recharge starts a training-load countdown. When it runs out, the estimate is complete. Recharge reads Apple Health and never writes to it.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokonči trénink, který se započítává, a Recharge spustí odpočet tréninkové zátěže. Když doběhne, odhad je dokončen. Recharge data z Apple Health jen čte a nic tam nezapisuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende ein qualifizierendes Workout, und Recharge startet einen Countdown für die Trainingsbelastung. Wenn er abläuft, ist die Schätzung abgeschlossen. Recharge liest Apple Health und schreibt nie hinein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish a qualifying workout and Recharge starts a training-load countdown. When it runs out, the estimate is complete. Recharge reads Apple Health and never writes to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina un entrenamiento válido y Recharge inicia una cuenta atrás de carga de entrenamiento. Cuando llega a cero, la estimación está completa. Recharge lee Apple Health y nunca escribe en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine un entraînement éligible et Recharge lance un compte à rebours de charge d'entraînement. Quand il arrive à zéro, l'estimation est terminée. Recharge lit Apple Health et n'y écrit jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina un allenamento idoneo e Recharge avvia un conto alla rovescia del carico di allenamento. Quando finisce, la stima è completata. Recharge legge Apple Health e non vi scrive mai."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อออกกำลังกายตามเกณฑ์เสร็จ Recharge จะเริ่มนับถอยหลังตามภาระการฝึก เมื่อหมดเวลา ช่วงเวลาที่ประมาณไว้ก็สิ้นสุดลง Recharge อ่านข้อมูลจาก Apple Health โดยไม่เขียนข้อมูลกลับ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一次符合条件的体能训练后，Recharge 会启动训练负荷倒计时。倒计时结束时，估算即告完成。Recharge 只读取 Apple Health，绝不写入。"
          }
        }
      }
    },
    "Finish a workout and Recharge will estimate a training-load window.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokonči trénink a Recharge odhadne časové okno tréninkové zátěže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende ein Workout, und Recharge schätzt ein Zeitfenster für die Trainingsbelastung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish a workout and Recharge will estimate a training-load window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina un entrenamiento y Recharge estimará una ventana de carga de entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine un entraînement et Recharge estimera une période de récupération liée à ta charge d’entraînement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina un allenamento e Recharge stimerà una finestra di carico di allenamento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อออกกำลังกายเสร็จ Recharge จะประมาณช่วงเวลาของภาระการฝึกให้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一次体能训练后，Recharge 会估算训练负荷恢复时间。"
          }
        }
      }
    },
