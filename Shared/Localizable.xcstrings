    "How quickly your last %lld days say you come back. It is one of the things Recharge+ changes, not the whole difference between the two figures above.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak rychle podle údajů za %#@n1@ regeneruješ. Je to jedna z věcí, které Recharge+ mění, ne celý rozdíl mezi dvěma údaji výše."
          },
          "substitutions": {
