    "Countdown-complete notifications are included on every tier when you allow notifications.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení o dokončení odpočtu jsou součástí každé úrovně, pokud povolíš oznámení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen zum Ende des Countdowns sind in jeder Stufe enthalten, wenn du Mitteilungen erlaubst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown-complete notifications are included on every tier when you allow notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de fin de cuenta atrás se incluyen en todos los niveles si permites las notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de fin de compte à rebours sont incluses dans toutes les formules si tu autorises les notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di fine conto alla rovescia sono incluse in ogni livello quando consenti le notifiche."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนเมื่อการนับถอยหลังเสร็จสิ้นรวมอยู่ในทุกระดับ เมื่อคุณอนุญาตการแจ้งเตือน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许通知后，每个等级都包含倒计时结束通知。"
          }
        }
      }
    },
    "Countdowns now reach four days, so a half marathon or a marathon reads longer than a long run.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpočty nově sahají až na čtyři dny, takže půlmaraton nebo maraton vychází déle než dlouhý běh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdowns reichen jetzt bis zu vier Tage, sodass ein Halbmarathon oder Marathon länger angezeigt wird als ein langer Lauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdowns now reach four days, so a half marathon or a marathon reads longer than a long run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas atrás ahora llegan a cuatro días, de modo que una media maratón o una maratón muestran una duración mayor que una carrera larga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes à rebours peuvent désormais atteindre quatre jours : un semi-marathon ou un marathon affiche une durée plus longue qu'une sortie longue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I conti alla rovescia ora arrivano a quattro giorni, così il tempo indicato dopo una mezza maratona o una maratona è più lungo rispetto a quello dopo una corsa lunga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนับถอยหลังยาวได้ถึงสี่วัน ฮาล์ฟมาราธอนหรือมาราธอนจึงแสดงนานกว่าการวิ่งระยะไกล"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒计时现在最长可达四天，因此半程马拉松或全程马拉松显示的时长会比一次长跑更久。"
          }
        }
      }
    },
    "Counted toward your training load, but no countdown started.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Započteno do tvé tréninkové zátěže, odpočet se ale nespustil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt zu deiner Trainingsbelastung, aber es wurde kein Countdown gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted toward your training load, but no countdown started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta para tu carga de entrenamiento, pero no se inició ninguna cuenta atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pris en compte dans ta charge d'entraînement, mais aucun compte à rebours n'a démarré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteggiato nel tuo carico di allenamento, ma nessun conto alla rovescia avviato."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับรวมในภาระการฝึกของคุณ แต่ไม่ได้เริ่มการนับถอยหลัง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已计入你的训练负荷，但未启动倒计时。"
          }
        }
      }
    },
    "Counted toward your training load. Not enough on its own to start a countdown.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Započteno do tvé tréninkové zátěže. Samo o sobě nestačí ke spuštění odpočtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt zu deiner Trainingsbelastung. Allein nicht genug, um einen Countdown zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted toward your training load. Not enough on its own to start a countdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta para tu carga de entrenamiento. Por sí sola no basta para iniciar una cuenta atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pris en compte dans ta charge d'entraînement. Insuffisant à lui seul pour lancer un compte à rebours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteggiato nel tuo carico di allenamento. Da solo non basta per avviare un conto alla rovescia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับรวมในภาระการฝึกของคุณ แต่ลำพังไม่พอที่จะเริ่มการนับถอยหลัง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已计入你的训练负荷。仅凭这一次不足以启动倒计时。"
          }
        }
      }
    },
