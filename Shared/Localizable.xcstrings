    "Health answered but returned no qualifying workouts. If you have trained recently, check that workouts are allowed for Recharge in the Health app.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z Health nepřišly žádné tréninky, které se započítávají. Pokud nedávno nějaký trénink proběhl, zkontroluj v aplikaci Health, zda má Recharge povolený přístup k tréninkům."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health hat geantwortet, aber keine qualifizierenden Workouts geliefert. Wenn du kürzlich trainiert hast, prüfe in der Health-App, ob Workouts für Recharge erlaubt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health answered but returned no qualifying workouts. If you have trained recently, check that workouts are allowed for Recharge in the Health app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health respondió, pero no devolvió entrenamientos válidos. Si has entrenado hace poco, comprueba que los entrenamientos estén permitidos para Recharge en la app Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health a répondu mais n’a renvoyé aucun entraînement éligible. Si tu t’es entraîné récemment, vérifie que les entraînements sont autorisés pour Recharge dans l’app Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health ha risposto ma non ha restituito allenamenti idonei. Se di recente hai fatto allenamento, controlla che gli allenamenti siano consentiti per Recharge nell'app Health."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Health ตอบกลับแล้วแต่ไม่พบการออกกำลังกายที่เข้าเกณฑ์ หากคุณออกกำลังกายเมื่อเร็ว ๆ นี้ ให้ตรวจสอบว่าอนุญาตให้ Recharge เข้าถึงการออกกำลังกายในแอป Health"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health 已响应，但未返回符合条件的体能训练。如果你最近有训练，请在 Health App 中检查是否已允许 Recharge 读取体能训练。"
          }
        }
      }
    },
    "Heart rate variability": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Variabilita tepové frekvence"
          }
