    "Your own %lld-day pattern lengthens this by about %lld%%.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj vlastní vzorec za období %lld d to prodlužuje zhruba o %lld %%."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein eigenes %lld-Tage-Muster verlängert das um etwa %lld%%."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own %lld-day pattern lengthens this by about %lld%%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propio patrón de %lld días alarga esto en torno a un %lld%%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton propre rythme sur %lld jours allonge cette durée d'environ %lld %%."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo andamento degli ultimi %lld giorni allunga questo valore di circa il %lld%%."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบ %lld วันของคุณทำให้ระยะเวลานี้ยาวขึ้นประมาณ %lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己 %lld 天的规律使这一时间延长约 %lld%%。"
          }
        }
      }
    },
    "Your own %lld-day pattern shortens this by about %lld%%.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj vlastní vzorec za období %lld d to zkracuje zhruba o %lld %%."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein eigenes %lld-Tage-Muster verkürzt das um etwa %lld%%."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own %lld-day pattern shortens this by about %lld%%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propio patrón de %lld días acorta esto en torno a un %lld%%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton propre rythme sur %lld jours raccourcit cette durée d'environ %lld %%."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo andamento degli ultimi %lld giorni riduce questo valore di circa il %lld%%."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบ %lld วันของคุณทำให้ระยะเวลานี้สั้นลงประมาณ %lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己 %lld 天的规律使这一时间缩短约 %lld%%。"
          }
        }
      }
    },
    "Your own read on it. Recharge starts here and replaces it with what your data shows.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj vlastní odhad. Recharge začíná od něj a nahradí ho tím, co ukazují tvá data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigene Einschätzung. Recharge startet damit und ersetzt sie durch das, was deine Daten zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own read on it. Recharge starts here and replaces it with what your data shows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propia idea al respecto. Recharge parte de aquí y la sustituye por lo que muestran tus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton propre ressenti. Recharge part de là, puis le remplace par ce que montrent tes données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua impressione. Recharge parte da qui e la sostituisce con ciò che mostrano i tuoi dati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประเมินของคุณเอง Recharge จะเริ่มจากค่านี้ แล้วแทนที่ด้วยสิ่งที่ข้อมูลของคุณแสดง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你自己的判断。Recharge 以此为起点，之后会换成你的数据所显示的结果。"
          }
        }
      }
    },
