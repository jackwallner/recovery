    "Enter a value between 120 and 230 bpm. Recharge is using its own estimate until then.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej hodnotu mezi 120 a 230 bpm. Do té doby Recharge používá vlastní odhad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Wert zwischen 120 und 230 bpm ein. Bis dahin nutzt Recharge die eigene Schätzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a value between 120 and 230 bpm. Recharge is using its own estimate until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un valor entre 120 y 230 lpm. Hasta entonces, Recharge usa su propia estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis une valeur entre 120 et 230 bpm. D'ici là, Recharge utilise sa propre estimation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un valore tra 120 e 230 bpm. Fino ad allora Recharge usa la propria stima."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนค่าระหว่าง 120 ถึง 230 bpm ระหว่างนี้ Recharge จะใช้ค่าประมาณของตัวเอง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 120 到 230 bpm 之间的数值。在此之前，Recharge 将使用自身的估算值。"
          }
        }
      }
    },
    "Enter a value from %lld to %lld beats per minute, or leave blank for automatic.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej hodnotu od %lld do %lld tepů za minutu, nebo nech pole prázdné pro automatické nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Wert von %lld bis %lld Schlägen pro Minute ein oder lass das Feld für Automatik leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a value from %lld to %lld beats per minute, or leave blank for automatic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un valor de %lld a %lld latidos por minuto o déjalo en blanco para el modo automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis une valeur de %lld à %lld battements par minute, ou laisse vide pour le mode automatique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un valore da %lld a %lld battiti al minuto oppure lascia vuoto per usare il valore automatico."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนค่าตั้งแต่ %lld ถึง %lld ครั้งต่อนาที หรือเว้นว่างไว้เพื่อใช้อัตโนมัติ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 %lld 到 %lld 次/分钟的数值，留空则为自动。"
          }
        }
      }
    },
