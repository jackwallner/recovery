    "Standard %@. Your Recharge+ time is hidden until you upgrade.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardní %@. Tvůj čas Recharge+ zůstává skrytý, dokud nepřejdeš na vyšší úroveň."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard %@. Deine Recharge+-Zeit ist bis zum Upgrade ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard %@. Your Recharge+ time is hidden until you upgrade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estándar %@. Tu tiempo de Recharge+ queda oculto hasta que mejores tu plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard %@. Ton temps Recharge+ est masqué jusqu’à ton passage à Recharge+."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard %@. Il tuo tempo Recharge+ resta nascosto finché non passi a Recharge+."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มาตรฐาน %@ เวลา Recharge+ ของคุณจะซ่อนไว้จนกว่าจะอัปเกรด"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准 %@。升级后才会显示你的 Recharge+ 时间。"
          }
        }
      }
    },
    "Standard estimate at your training level, scored against your heart-rate range.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardní odhad podle tvé úrovně tréninku, hodnocený vůči tvému rozsahu tepové frekvence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard-Schätzung für dein Trainingsniveau, bewertet anhand deines Herzfrequenzbereichs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard estimate at your training level, scored against your heart-rate range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación estándar según tu nivel de entrenamiento, valorada con tu rango de frecuencia cardiaca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation standard à ton niveau d’entraînement, évaluée selon ta plage de fréquence cardiaque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stima standard al tuo livello di allenamento, valutata rispetto al tuo intervallo di frequenza cardiaca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าประมาณมาตรฐานตามระดับการฝึกของคุณ ประเมินเทียบกับช่วงอัตราการเต้นของหัวใจของคุณ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的训练水平给出的标准估算，依据你的心率范围评分。"
          }
        }
      }
    },
    "Standard is a recovery time again": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardní je opět doba regenerace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard ist wieder eine Erholungszeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard is a recovery time again"
          }
        },
        "es": {
