    "Recharge's local Health cache and estimates were deleted. Apple Health records and purchases were not changed.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní mezipaměť Health a odhady v Recharge byly smazány. Záznamy v Apple Health ani nákupy se nezměnily."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Health-Cache und die Schätzungen von Recharge wurden gelöscht. Einträge in Apple Health und Käufe wurden nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge's local Health cache and estimates were deleted. Apple Health records and purchases were not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado la caché local de Health y las estimaciones de Recharge. Los registros de Apple Health y las compras no se han modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache Health local et les estimations de Recharge ont été supprimés. Les données Apple Health et les achats n’ont pas été modifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cache locale di Health e le stime di Recharge sono state eliminate. I dati di Apple Health e gli acquisti non sono stati modificati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบแคช Health ในเครื่องและค่าประมาณของ Recharge แล้ว ข้อมูลใน Apple Health และการซื้อไม่มีการเปลี่ยนแปลง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge 本地的 Health 缓存和估算已删除。Apple Health 记录和购买项目未受影响。"
          }
        }
      }
    },
