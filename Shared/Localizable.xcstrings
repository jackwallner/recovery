    },
    "You marked this session light, so it counts as active recovery.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podle tvého označení „lehký“ se tento trénink počítá jako aktivní regenerace."
          }
        },
