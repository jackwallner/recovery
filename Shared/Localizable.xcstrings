    "Auto is %lld bpm, predicted from your age. It becomes a measured figure once your sessions show a higher one.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto je %lld bpm, odhad podle tvého věku. Jakmile tvé tréninky ukážou vyšší hodnotu, použije se naměřená."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto liegt bei %lld bpm, geschätzt anhand deines Alters. Sobald deine Einheiten einen höheren Wert zeigen, wird daraus ein gemessener Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto is %lld bpm, predicted from your age. It becomes a measured figure once your sessions show a higher one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto es %lld lpm, estimado a partir de tu edad. Pasa a ser un valor medido cuando tus sesiones muestren uno más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto : %lld bpm, estimé d'après ton âge. Cette valeur devient une mesure dès que tes séances en montrent une plus élevée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto è %lld bpm, previsto in base alla tua età. Diventa un valore misurato quando le tue sessioni ne mostrano uno più alto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตโนมัติคือ %lld bpm ซึ่งคาดการณ์จากอายุของคุณ ค่านี้จะกลายเป็นค่าที่วัดได้เมื่อเซสชันของคุณแสดงค่าที่สูงกว่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动值为 %lld bpm，根据你的年龄推算。一旦你的训练记录显示出更高的数值，将改用实测值。"
          }
        }
      }
    },
    "Auto is %lld bpm, the highest your own sessions have shown. Override it only if you have tested higher.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto je %lld bpm, nejvyšší hodnota z tvých tréninků. Přepiš ji jen tehdy, když máš otestovanou vyšší hodnotu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto liegt bei %lld bpm, dem höchsten Wert deiner bisherigen Einheiten. Ändere ihn nur, wenn du einen höheren Wert getestet hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto is %lld bpm, the highest your own sessions have shown. Override it only if you have tested higher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto es %lld lpm, el valor más alto que han mostrado tus sesiones. Cámbialo solo si has medido uno más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto : %lld bpm, la valeur la plus élevée relevée lors de tes séances. Ne la modifie que si tu as déjà mesuré plus haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto è %lld bpm, il valore più alto registrato nelle tue sessioni. Modificalo solo se hai misurato un valore più alto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตโนมัติคือ %lld bpm ซึ่งเป็นค่าสูงสุดที่เซสชันของคุณเคยแสดง กำหนดเองเฉพาะเมื่อคุณทดสอบแล้วได้ค่าที่สูงกว่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动值为 %lld bpm，即你的训练记录中出现过的最高值。仅当你实测过更高数值时才需要手动覆盖。"
          }
        }
      }
    },
    "Auto uses the model's own estimate. Set yours for a sharper heart-rate load.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto používá odhad modelu. Zadej vlastní hodnotu pro přesnější zátěž podle tepové frekvence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto nutzt die eigene Schätzung des Modells. Gib deinen Wert ein für eine genauere Herzfrequenzbelastung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto uses the model's own estimate. Set yours for a sharper heart-rate load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto usa la estimación del propio modelo. Introduce la tuya para una carga de frecuencia cardiaca más precisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto utilise l'estimation du modèle. Saisis la tienne pour une charge cardiaque plus précise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto usa la stima del modello. Imposta il tuo valore per un carico cardiaco più preciso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตโนมัติใช้ค่าประมาณของโมเดล ตั้งค่าของคุณเองเพื่อให้ภาระจากอัตราการเต้นของหัวใจแม่นยำขึ้น"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动模式使用模型自身的估算值。设置你自己的数值，可让心率负荷估算更精确。"
          }
        }
      }
    },
