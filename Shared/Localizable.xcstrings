            "value": "Variabilité de la fréquence cardiaque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV (variabilità della frequenza cardiaca)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความแปรปรวนของอัตราการเต้นของหัวใจ (HRV)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
