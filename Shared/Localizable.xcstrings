    "Apple Health checked. Pull down to read it again at any time.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health zkontrolováno. Přetažením dolů ho můžeš kdykoli načíst znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health geprüft. Zum erneuten Einlesen jederzeit nach unten ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health checked. Pull down to read it again at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health revisado. Desliza hacia abajo para volver a leerlo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health consulté. Tire vers le bas pour relancer la lecture à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health controllato. Trascina verso il basso per rileggerlo in qualsiasi momento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจ Apple Health แล้ว ดึงลงเพื่ออ่านอีกครั้งได้ทุกเมื่อ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检查 Apple Health。随时可下拉重新读取。"
          }
        }
      }
    },
    "Apple Health groups functional and hybrid training under the same activity type, so Recharge needs to know which curve to use. Calibration adjusts from your answers when a countdown runs out.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health řadí funkční a hybridní trénink pod stejný typ aktivity, proto Recharge potřebuje vědět, kterou křivku použít. Kalibrace se podle tvých odpovědí upraví, když odpočet doběhne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health fasst Funktions- und Hybridtraining unter derselben Aktivitätsart zusammen, daher muss Recharge wissen, welche Kurve es verwenden soll. Die Kalibrierung passt sich anhand deiner Antworten an, wenn ein Countdown abläuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health groups functional and hybrid training under the same activity type, so Recharge needs to know which curve to use. Calibration adjusts from your answers when a countdown runs out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health agrupa el entrenamiento funcional y el híbrido bajo el mismo tipo de actividad, así que Recharge necesita saber qué curva usar. La calibración se ajusta con tus respuestas cuando termina una cuenta atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health regroupe l’entraînement fonctionnel et hybride sous le même type d’activité, donc Recharge doit savoir quelle courbe utiliser. La calibration s’ajuste d’après tes réponses quand un compte à rebours se termine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health raggruppa l'allenamento funzionale e quello ibrido sotto lo stesso tipo di attività, quindi Recharge deve sapere quale curva usare. La calibrazione si adatta alle tue risposte quando un conto alla rovescia termina."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health จัดการฝึกแบบฟังก์ชันนัลและไฮบริดไว้ในประเภทกิจกรรมเดียวกัน Recharge จึงต้องรู้ว่าจะใช้เส้นโค้งแบบใด การปรับเทียบจะปรับตามคำตอบของคุณเมื่อการนับถอยหลังสิ้นสุดลง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 将功能性训练和混合训练归为同一种活动类型，因此 Recharge 需要知道该用哪条曲线。倒计时结束时，校准会根据你的回答进行调整。"
          }
        }
      }
    },
    "Apple Health unread - open Recharge": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health nenačteno - otevři Recharge"
          }
        },
        "de": {
