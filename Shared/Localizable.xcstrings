          }
        }
      }
    },
    "Body signals fold your sleep, resting heart rate, and HRV into the estimate, within a bounded range. One reading never swings the countdown on its own.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tělesné signály zahrnují do odhadu tvůj spánek, klidovou tepovou frekvenci a HRV, a to v omezeném rozsahu. Jediné měření samo o sobě odpočet nikdy výrazně neovlivní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Körpersignale beziehen deinen Schlaf, deinen Ruhepuls und deine HRV innerhalb eines begrenzten Bereichs in die Schätzung ein. Ein einzelner Messwert verändert den Countdown nie allein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body signals fold your sleep, resting heart rate, and HRV into the estimate, within a bounded range. One reading never swings the countdown on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las señales corporales incorporan tu sueño, tu frecuencia cardiaca en reposo y tu VFC a la estimación, dentro de un rango limitado. Una sola lectura nunca modifica la cuenta atrás por sí sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signaux corporels intègrent ton sommeil, ta fréquence cardiaque au repos et ta VFC à l'estimation, dans une plage limitée. Une seule mesure ne fait jamais varier le compte à rebours à elle seule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segnali del corpo integrano sonno, frequenza cardiaca a riposo e HRV nella stima, entro un intervallo limitato. Una singola lettura non cambia mai da sola il conto alla rovescia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญญาณจากร่างกายจะนำการนอนหลับ อัตราการเต้นของหัวใจขณะพัก และ HRV มาร่วมในค่าประมาณภายในช่วงที่จำกัด ค่าที่อ่านได้เพียงครั้งเดียวจะไม่ทำให้การนับถอยหลังเปลี่ยนไปมากด้วยตัวเอง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身体信号会将你的睡眠、静息心率和心率变异性纳入估算，且调整幅度有限。单次读数不会单独大幅改变倒计时。"
          }
        }
      }
    },
