            "value": "Estándar vuelve a ser un tiempo de recuperación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard redevient un temps de récupération"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard torna a essere un tempo di recupero"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มาตรฐานกลับมาเป็นเวลาฟื้นตัวอีกครั้ง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
