          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist alles, was Recharge braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's everything Recharge needs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es todo lo que necesita Recharge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est tout ce dont Recharge a besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è tutto ciò che serve a Recharge."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge ได้ข้อมูลครบแล้ว"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge 需要的就这些了。"
          }
        }
      }
    },
    "The clock time you are estimated to be ready.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas, kdy podle odhadu nastane stav Připraveno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhrzeit, zu der du voraussichtlich bereit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock time you are estimated to be ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora estimada a la que llegarás a Listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure estimée à laquelle ton état passe à Prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orario stimato in cui lo stato diventa Pronto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาตามนาฬิกาที่คาดว่าคุณจะพร้อม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计就绪的具体时间。"
          }
        }
      }
    },
    "The free countdown scores each session at your training level, like a Garmin does, instead of repeating your usual gap between sessions. That gap is still shown beside it.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatný odpočet hodnotí každý trénink podle tvé úrovně tréninku, stejně jako Garmin, místo aby opakoval tvůj obvyklý odstup mezi tréninky. Ten odstup se zobrazuje vedle něj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Countdown bewertet jede Einheit auf deinem Trainingsniveau, so wie Garmin es tut, statt deinen üblichen Abstand zwischen Einheiten zu wiederholen. Dieser Abstand wird weiterhin daneben angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free countdown scores each session at your training level, like a Garmin does, instead of repeating your usual gap between sessions. That gap is still shown beside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta atrás gratuita valora cada sesión según tu nivel de entrenamiento, como hace un Garmin, en lugar de repetir tu intervalo habitual entre sesiones. Ese intervalo se sigue mostrando al lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte à rebours gratuit évalue chaque séance à ton niveau d’entraînement, comme le fait un Garmin, au lieu de reprendre ton écart habituel entre les séances. Cet écart reste affiché à côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto alla rovescia gratuito valuta ogni sessione al tuo livello di allenamento, come fa un Garmin, invece di ripetere il tuo solito intervallo tra le sessioni. Quell'intervallo resta comunque mostrato accanto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนับถอยหลังแบบฟรีประเมินแต่ละเซสชันตามระดับการฝึกของคุณ เหมือนที่ Garmin ทำ แทนการใช้ช่วงห่างปกติระหว่างเซสชันซ้ำ ช่วงห่างนั้นยังแสดงไว้ข้างกัน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费倒计时会像 Garmin 那样，按你的训练水平为每次训练评分，而不是重复你平时两次训练之间的间隔。该间隔仍会显示在旁边。"
          }
        }
      }
    },
    "The free estimate scores each session at your training level, the way a Garmin does before it knows you. Recharge+ scores it against your own sessions, sleep, and heart rate.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatný odhad hodnotí každý trénink podle tvé úrovně tréninku, tak jako Garmin, než tě pozná. Recharge+ ho hodnotí podle tvých vlastních tréninků, spánku a tepové frekvence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Schätzung bewertet jede Einheit auf deinem Trainingsniveau, so wie Garmin es tut, bevor es dich kennt. Recharge+ bewertet sie anhand deiner eigenen Einheiten, deines Schlafs und deiner Herzfrequenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free estimate scores each session at your training level, the way a Garmin does before it knows you. Recharge+ scores it against your own sessions, sleep, and heart rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estimación gratuita valora cada sesión según tu nivel de entrenamiento, como hace un Garmin antes de conocerte. Recharge+ la valora con tus propias sesiones, tu sueño y tu frecuencia cardiaca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estimation gratuite évalue chaque séance à ton niveau d’entraînement, comme le fait un Garmin avant de te connaître. Recharge+ l’évalue d’après tes propres séances, ton sommeil et ta fréquence cardiaque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stima gratuita valuta ogni sessione al tuo livello di allenamento, come fa un Garmin prima di conoscerti. Recharge+ la valuta rispetto alle tue sessioni, al sonno e alla frequenza cardiaca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าประมาณแบบฟรีประเมินแต่ละเซสชันตามระดับการฝึกของคุณ เหมือนที่ Garmin ทำก่อนจะรู้จักคุณ ส่วน Recharge+ ประเมินเทียบกับเซสชัน การนอนหลับ และอัตราการเต้นของหัวใจของคุณเอง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费估算会按你的训练水平为每次训练评分，就像 Garmin 在尚未了解你时那样。Recharge+ 则依据你自己的训练、睡眠和心率评分。"
          }
        }
      }
    },
    "The last read did not complete. Open the Health app, then Sharing, then Apps, then Recharge, and check that workouts are allowed.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední načtení se nedokončilo. Otevři aplikaci Health, přejdi na Sdílení, Aplikace a Recharge a zkontroluj, že jsou tréninky povolené."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das letzte Lesen wurde nicht abgeschlossen. Öffne die Health-App, dann Teilen, dann Apps, dann Recharge, und prüfe, ob Workouts erlaubt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last read did not complete. Open the Health app, then Sharing, then Apps, then Recharge, and check that workouts are allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última lectura no se completó. Abre la app Health, ve a Compartir, luego Apps y Recharge, y comprueba que los entrenamientos estén permitidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière lecture n’a pas abouti. Ouvre l’app Health, puis Partage, puis Apps, puis Recharge, et vérifie que les entraînements sont autorisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima lettura non è stata completata. Apri l'app Health, poi Condivisione, poi App, poi Recharge, e verifica che gli allenamenti siano consentiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอ่านครั้งล่าสุดไม่สำเร็จ เปิดแอป Health แล้วไปที่การแชร์ > แอป > Recharge และตรวจสอบว่าอนุญาตการออกกำลังกายไว้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次读取未能完成。请打开 Health App，依次选择“共享”、“App”、Recharge，并确认已允许体能训练。"
          }
        }
      }
    },
    "The nights before and after a session move the countdown within a bounded range, as they do on Garmin.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Noci před tréninkem a po něm posouvají odpočet v omezeném rozsahu, jako u zařízení Garmin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nächte vor und nach einer Einheit verschieben den Countdown innerhalb eines begrenzten Bereichs, wie bei Garmin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nights before and after a session move the countdown within a bounded range, as they do on Garmin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches anteriores y posteriores a una sesión mueven la cuenta atrás dentro de un rango limitado, como ocurre en Garmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuits avant et après une séance font varier le compte à rebours dans une plage limitée, comme sur Garmin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notti prima e dopo una sessione spostano il conto alla rovescia entro un intervallo limitato, come su Garmin."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนอนหลับคืนก่อนและหลังเซสชันปรับการนับถอยหลังภายในช่วงที่จำกัดไว้ เหมือนบน Garmin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练前后几晚的数据会在有限范围内调整倒计时，与 Garmin 的做法一样。"
          }
        }
      }
    },
    "The same, from the other direction.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Totéž, jen z opačného směru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe, aus der anderen Richtung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same, from the other direction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo mismo, en sentido contrario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareil, dans l’autre sens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso, dalla direzione opposta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่นเดียวกัน แต่จากอีกทิศทางหนึ่ง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同样如此，只是方向相反。"
          }
        }
      }
    },
    "This removes Recharge's imported workouts, estimates, snapshots, and Health-derived profile values from this device. It does not delete anything from Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se z tohoto zařízení odstraní importované tréninky, odhady, snímky a hodnoty profilu odvozené z Health v Recharge. Z Apple Health se nic nesmaže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die von Recharge importierten Workouts, Schätzungen, Snapshots und aus Health abgeleiteten Profilwerte von diesem Gerät entfernt. In Apple Health wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes Recharge's imported workouts, estimates, snapshots, and Health-derived profile values from this device. It does not delete anything from Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de este dispositivo los entrenamientos importados por Recharge, las estimaciones, las instantáneas y los valores de perfil derivados de Health. No borra nada de Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime de cet appareil les entraînements importés par Recharge, ses estimations, ses instantanés et ses données de profil issues de Health. Rien n’est supprimé d’Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove da questo dispositivo gli allenamenti importati, le stime, gli snapshot e i valori di profilo derivati da Health che Recharge ha salvato. Non elimina nulla da Apple Health."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบการออกกำลังกายที่นำเข้า ค่าประมาณ สแนปช็อต และค่าโปรไฟล์ที่ได้จาก Health ของ Recharge ออกจากอุปกรณ์เครื่องนี้ โดยไม่ลบสิ่งใดออกจาก Apple Health"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从此设备上移除 Recharge 导入的体能训练、估算、快照以及来自 Health 的个人资料数值。不会删除 Apple Health 中的任何内容。"
          }
        }
      }
    },
