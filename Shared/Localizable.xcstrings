    "You have held your usual intensity training inside the estimated window.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj trénink v obvyklé intenzitě proběhl v rámci odhadovaného okna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Einheiten in deiner üblichen Intensität innerhalb des geschätzten Zeitfensters absolviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have held your usual intensity training inside the estimated window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has mantenido tu intensidad habitual de entrenamiento dentro de la ventana estimada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as maintenu ton intensité d'entraînement habituelle pendant la fenêtre estimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai mantenuto l'intensità abituale dei tuoi allenamenti entro la finestra stimata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังคงฝึกด้วยความหนักตามปกติได้ แม้เริ่มฝึกภายในช่วงเวลาที่ประมาณไว้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在估算的恢复时间内，你一直保持常规强度的训练。"
          }
        }
      }
    },
