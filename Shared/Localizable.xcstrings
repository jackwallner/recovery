                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "degli ultimi %arg giorni"
                    }
                  }
                }
              }
            }
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกเซสชันจะได้รับคะแนนเทียบกับค่าพื้นฐาน %1$lld วันของคุณ แล้วปรับตามข้อมูลในช่วง %#@n2@ ที่ผ่านมาว่าคุณกลับมาฝึกได้เร็วแค่ไหน นี่คือค่าประมาณการฝึกระบบหัวใจและหลอดเลือด ไม่ใช่คำแนะนำทางการแพทย์"
          },
          "substitutions": {
            "n2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg วัน"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次训练都会与你自己 %1$lld 天的基线对比评分，再根据最近 %#@n2@ 中你恢复快慢的表现进行调整。这是心血管训练估算，不是医疗建议。"
          },
          "substitutions": {
            "n2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg 天"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Every session scored against your own 42-day baseline and 30-day recovery pattern.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý trénink se hodnotí podle tvé vlastní 42denní základní úrovně a 30denního vzorce regenerace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Einheit wird an deinem eigenen 42-Tage-Basiswert und deinem 30-Tage-Erholungsmuster gemessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
