          }
        }
      }
    },
    "Standard is the model at your training level. Recharge+ scores this session against your own baseline, sleep, and heart rate.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardní je model podle tvé úrovně tréninku. Recharge+ hodnotí tento trénink podle tvé vlastní základní úrovně, spánku a tepové frekvence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard ist das Modell für dein Trainingsniveau. Recharge+ bewertet diese Einheit anhand deines eigenen Basiswerts, deines Schlafs und deiner Herzfrequenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard is the model at your training level. Recharge+ scores this session against your own baseline, sleep, and heart rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estándar es el modelo según tu nivel de entrenamiento. Recharge+ valora esta sesión con tu propia línea base, tu sueño y tu frecuencia cardiaca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard est le modèle à ton niveau d’entraînement. Recharge+ évalue cette séance d’après ta propre référence, ton sommeil et ta fréquence cardiaque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard è il modello al tuo livello di allenamento. Recharge+ valuta questa sessione rispetto alla tua base personale, al sonno e alla frequenza cardiaca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มาตรฐานคือโมเดลตามระดับการฝึกของคุณ Recharge+ ประเมินเซสชันนี้เทียบกับค่าพื้นฐาน การนอนหลับ และอัตราการเต้นของหัวใจของคุณเอง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准是按你的训练水平建立的模型。Recharge+ 则依据你自己的基线、睡眠和心率为这次训练评分。"
          }
        }
      }
    },
    "State": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
