    "An example on the real curve until you have recorded a qualifying session. The arithmetic is the same one your own sessions get.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázka na skutečné křivce, dokud nezaznamenáš trénink, který se započítává. Výpočet je stejný jako u tvých vlastních tréninků."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Beispiel auf der echten Kurve, bis du eine Einheit aufgezeichnet hast, die die Kriterien erfüllt. Deine eigenen Einheiten werden genauso berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An example on the real curve until you have recorded a qualifying session. The arithmetic is the same one your own sessions get."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ejemplo sobre la curva real hasta que registres una sesión válida. El cálculo es el mismo que se aplica a tus propias sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un exemple sur la vraie courbe, en attendant une première séance qualifiante. Le calcul est le même que pour tes propres séances."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un esempio sulla curva reale finché non registri una sessione idonea. Il calcolo è lo stesso che viene applicato alle tue sessioni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอย่างบนเส้นโค้งจริงจนกว่าคุณจะบันทึกเซสชันที่เข้าเกณฑ์ โดยใช้วิธีคำนวณเดียวกับเซสชันของคุณ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你记录第一次符合条件的训练之前，这里显示的是真实曲线上的示例。计算方式与你自己的训练完全相同。"
          }
        }
      }
    },
