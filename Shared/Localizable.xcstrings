        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo una sessione moderata di solito hai ripreso ad allenarti dopo circa %1$@ (%#@n2@)."
          },
          "substitutions": {
            "n2": {
              "argNum": 2,
