    "%@. Auto-renews unless cancelled 24h before the period ends.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Automaticky se obnovuje, pokud není zrušeno alespoň 24 h před koncem období."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Verlängert sich automatisch, sofern du nicht 24 Std. vor Ende des Zeitraums kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Auto-renews unless cancelled 24h before the period ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Se renueva automáticamente salvo que canceles 24 h antes de que termine el periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Renouvellement automatique, sauf annulation 24 h avant la fin de la période."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Si rinnova automaticamente salvo annullamento 24 ore prima della fine del periodo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ต่ออายุอัตโนมัติ เว้นแต่ยกเลิกอย่างน้อย 24 ชม. ก่อนสิ้นสุดรอบ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。除非在周期结束前 24 小时取消，否则自动续订。"
          }
        }
      }
    },
    "%@. Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Automaticky se obnovuje, pokud není zrušeno nejméně 24 hodin před koncem aktuálního období. Správu nebo zrušení najdeš v Nastavení › Apple ID › Předplatné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Verlängert sich automatisch, sofern du nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums kündigst. Verwalten oder kündigen unter Einstellungen › Apple-ID › Abonnements."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Se renueva automáticamente salvo que canceles al menos 24 horas antes de que termine el periodo actual. Gestiona o cancela en Ajustes › ID de Apple › Suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Renouvellement automatique, sauf annulation au moins 24 heures avant la fin de la période en cours. Gère ou annule dans Réglages › Apple ID › Abonnements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Si rinnova automaticamente a meno che tu non annulli almeno 24 ore prima della fine del periodo in corso. Gestisci o annulla in Impostazioni › Apple ID › Abbonamenti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ต่ออายุอัตโนมัติ เว้นแต่ยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบปัจจุบัน จัดการหรือยกเลิกได้ใน การตั้งค่า › Apple ID › การสมัครสมาชิก"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。除非在当前周期结束前至少 24 小时取消，否则将自动续订。可在“设置 › Apple ID › 订阅”中管理或取消。"
          }
        }
      }
    },
