    "%@ didn't have usable heart-rate data. Your rating counts whenever it reads harder than the other signals.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nebyla k dispozici použitelná data o tepové frekvenci. Tvé hodnocení se započítá vždy, když vychází náročněji než ostatní signály."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hatte keine verwertbaren Herzfrequenzdaten. Deine Bewertung zählt immer dann, wenn sie intensiver ausfällt als die anderen Signale."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't have usable heart-rate data. Your rating counts whenever it reads harder than the other signals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tenía datos de frecuencia cardiaca utilizables. Tu valoración cuenta siempre que indique un esfuerzo mayor que las demás señales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’avait pas de données de fréquence cardiaque exploitables. Ta note compte dès qu’elle indique un effort plus intense que les autres signaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non aveva dati di frequenza cardiaca utilizzabili. La tua valutazione conta ogni volta che indica uno sforzo maggiore rispetto agli altri segnali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่มีข้อมูลอัตราการเต้นของหัวใจที่ใช้งานได้ ระบบจะใช้คะแนนของคุณเมื่อคุณให้คะแนนว่าหนักกว่าสัญญาณอื่น"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
