    "Couldn't refresh your subscription status. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav předplatného se nepodařilo obnovit. Zkontroluj připojení a zkus to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abostatus konnte nicht aktualisiert werden. Prüfe deine Verbindung und versuche es erneut."
