    "Seen in your sessions, below what your age predicts, so the higher figure is used.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnota z tvých tréninků je nižší, než odpovídá tvému věku, proto se použije ta vyšší."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinen Einheiten beobachtet, aber unter dem, was dein Alter erwarten lässt. Daher wird der höhere Wert verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seen in your sessions, below what your age predicts, so the higher figure is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrado en tus sesiones, por debajo de lo que predice tu edad, así que se usa la cifra más alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeur relevée pendant tes séances, inférieure à celle que prédit ton âge : la plus élevée est donc retenue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valore rilevato nelle tue sessioni, inferiore a quanto previsto dalla tua età: si usa il valore più alto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าที่พบในเซสชันของคุณต่ำกว่าค่าที่คาดจากอายุ จึงใช้ค่าที่สูงกว่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的训练中记录到的数值低于按年龄推算的数值，因此采用较高的那个。"
          }
        }
      }
    },
