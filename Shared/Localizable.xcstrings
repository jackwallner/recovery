    "Tell me what would make the countdown more useful. It goes straight to me.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiš mi, co by odpočet udělalo užitečnějším. Zpráva přijde přímo mně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag mir, was den Countdown nützlicher machen würde. Es kommt direkt bei mir an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me what would make the countdown more useful. It goes straight to me."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntame qué haría más útil la cuenta atrás. Me llega directamente a mí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-moi ce qui rendrait le compte à rebours plus utile. Ton message m’arrive directement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimmi cosa renderebbe più utile il conto alla rovescia. Arriva direttamente a me."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกเราได้ว่าอะไรจะทำให้การนับถอยหลังมีประโยชน์ขึ้น ข้อความจะส่งตรงถึงเรา"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我怎样能让倒计时更有用。你的反馈会直接发给我。"
          }
        }
      }
    },
