opt_out_usage

default_platform(:ios)

REVIEW_NOTES = <<~NOTES
  Recharge shows a recovery-time countdown after every qualifying workout, and a clear Ready state when it expires.

  No account or login is required. The app requests read access to Workouts, Heart Rate, Resting Heart Rate, Heart Rate Variability, Sleep, Active Energy, Date of Birth, and Biological Sex, and never writes Health data. Date of Birth and Biological Sex set the heart-rate range used to measure session intensity.

  IMPORTANT FOR REVIEW: every number here comes from workouts already in Apple Health. On a device with no workout history the app correctly shows an empty state ("No workout yet") rather than a countdown. Step 2 creates a workout in about a minute so the full experience can be reviewed without training.

  1. GRANT HEALTH ACCESS
  Launch Recharge. Step through onboarding and tap Connect Apple Health. On the Health permission sheet tap "Turn On All", then Allow. Onboarding then asks two or three short profile questions and ends on a Recharge+ offer; tap "Get Started" to continue on the free tier.

  2. CREATE A QUALIFYING WORKOUT (no exercise needed)
  Open Apple's built-in Health app > Browse > Activity > Workouts > Add Data (top right).
  Set Activity Type: Traditional Strength Training
  Set Kilocalories: 500
  Set the start time to earlier today and the end time 60 minutes later.
  Tap Add.

  3. SEE THE COUNTDOWN
  Return to Recharge and open the Today tab. Pull down to refresh. A countdown in hours appears within a few seconds, with the phase headline, the session that set it, and a confidence rating.

  4. SEE WHY
  Today shows the explanation inline below the countdown: which session set the window, its load, which signal produced that load (heart rate, reported effort, active energy, or duration), and heart-rate coverage. The History tab lists every scored session with the same detail.

  5. STRENGTH EFFORT PROMPT
  The workout added in step 2 is a strength session with no heart-rate samples, so wrist heart rate cannot score it. Today therefore shows a card reading "How hard was that session?". Tap it and pick a rating from 1 to 10; the countdown recalculates immediately from the answer. The same one-tap prompt appears on the Apple Watch app when a phone-scored session is waiting for an answer, and the answer is sent from the Watch back to the phone.

  6. APPLE WATCH AND COMPLICATIONS
  Open Recharge on the paired Watch: it renders the same countdown from a snapshot the phone writes to the shared App Group (the Watch never queries Health itself). Complications come in four families (circular, rectangular, inline, corner). Pick the style in the iPhone Settings tab under Watch complication, then add Recharge to a watch face.

  7. EMPTY AND FAILURE STATES
  Deleting the workout added in step 2 from the Health app and refreshing returns Today to the "No workout yet" empty state. If Health returns nothing because access was denied, the Today footer and the Settings > Health status row say so explicitly rather than showing a stale number; iOS never reports read authorization to apps, so that row reports what Health returned, not which categories were granted.

  DISCLAIMER AND CLAIMS
  Recharge presents a cardiovascular training estimate only. It makes no diagnostic, treatment, or injury-prevention claim. A disclaimer saying so, and advising the user to talk with a qualified health professional before making medical decisions, is shown on the Today screen, in Settings, in onboarding, and on the paywall.

  IN-APP PURCHASES
  Recharge+ (via RevenueCat) offers monthly and yearly auto-renewable subscriptions with a 7-day free trial for eligible new subscribers, plus an optional one-time lifetime purchase. Reach the paywall from the Recharge+ row on Today or from Settings. Price, billing period, renewal behavior, Restore, Terms (Apple Standard EULA), and Privacy all appear at the purchase point. The app does not use non-exempt encryption.
NOTES

platform :ios do
  desc "Download current metadata + screenshots from App Store Connect into /tmp/asc-live"
  lane :download_state do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    sh("rm -rf /tmp/asc-live && mkdir -p /tmp/asc-live")

    deliver(
      api_key: api_key,
      run_precheck_before_submit: false,
      metadata_path: "/tmp/asc-live/metadata",
      screenshots_path: "/tmp/asc-live/screenshots",
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true
    )
  end

  desc "Upload screenshots and metadata to App Store Connect (fastlane 2.234+)"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION (run: eval \"$(python3 scripts/asc-ensure-draft-version.py | grep '^export ')\")") unless version && !version.empty?

    # Screenshots are generated by scripts/capture-screenshots.sh.
    skip_shots = ENV.fetch("SKIP_SCREENSHOTS", "true") == "true"

    deliver(
      api_key: api_key,
      app_version: version,
      skip_app_version_update: true,
      force: true,
      ignore_language_directory_validation: true,
      precheck_include_in_app_purchases: false,
      version_check_wait_retry_limit: 7,
      skip_binary_upload: true,
      skip_screenshots: skip_shots,
      overwrite_screenshots: !skip_shots,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      app_review_information: {
        first_name: "Jack",
        last_name: "Wallner",
        phone_number: "+1 425 753 3411",
        email_address: "jackwallner@gmail.com",
        demo_user: "N/A, no login, no account system",
        demo_password: "",
        notes: REVIEW_NOTES
      },
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Submit the draft version for App Store review (metadata already uploaded)"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION") unless version && !version.empty?
    build_number = ENV["ASC_BUILD_NUMBER"]
    UI.user_error!("Set ASC_BUILD_NUMBER") unless build_number && !build_number.empty?

    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build_number,
      skip_app_version_update: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: true,
      # The ASC version is set to MANUAL release. Asking deliver for automatic
      # release here would flip that behind our back and ship 1.0.0 the moment
      # review passes, with no chance to check the live listing first.
      automatic_release: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
